          <div class="gallery-overlay">
            <i class="fas fa-search-plus"></i>
          </div>
        </div>
        
        <div class="gallery-item">
          <img src="/images/dj_od_atwork.jpeg" alt="Professional DJ performing at event with equipment" title="DJ Performance - Metro Beat Events" loading="lazy" width="400" height="300">
