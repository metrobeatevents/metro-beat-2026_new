---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Metro Beat Events | Wedding DJ, Photography & Lighting | Woodbridge VA"
  description="Premier wedding DJ, photography & lighting services in Woodbridge VA. Serving DMV area within 40 miles. 500+ events, 5-star rated, fully insured. Book your free consultation today!"
  version="c"
>
  <Header />
  <Hero />

  <!-- Services Section -->
  <section id="services" class="services">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title" data-en="Our Services" data-es="Nuestros Servicios">Our Services</h2>
        <p class="section-subtitle" data-en="Complete entertainment solutions to make your event unforgettable. From premium sound and music curation to stunning lighting and professional photography, we handle every detail so you can focus on celebrating." data-es="Soluciones de entretenimiento completas para hacer que su evento sea inolvidable. Desde sonido premium y curación de música hasta iluminación impresionante y fotografía profesional, nos encargamos de cada detalle para que pueda enfocarse en celebrar.">
          Complete entertainment solutions to make your event unforgettable. From premium sound and music curation to stunning lighting and professional photography, we handle every detail so you can focus on celebrating.
        </p>
      </div>

      <div class="services-grid">
        <div class="service-card">
          <div class="service-icon">
            <i class="fas fa-headphones"></i>
          </div>
          <h3 class="service-title" data-en="DJ + MC Services" data-es="Servicios de DJ + MC">DJ + MC Services</h3>
          <p class="service-description" data-en="Keep your guests dancing all night long. DJ O.D. expertly reads the crowd and curates the perfect mix of music for every moment—from ceremony to celebration. With professional MC services, announcements flow seamlessly and your event stays on schedule." data-es="Mantenga a sus invitados bailando toda la noche. DJ O.D. lee experto la multitud y cura la mezcla perfecta de música para cada momento, desde la ceremonia hasta la celebración. Con servicios profesionales de MC, los anuncios fluyen sin problemas y su evento se mantiene en horario.">
            Keep your guests dancing all night long. DJ O.D. expertly reads the crowd and curates the perfect mix of music for every moment—from ceremony to celebration. With professional MC services, announcements flow seamlessly and your event stays on schedule.
          </p>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <i class="fas fa-camera"></i>
          </div>
          <h3 class="service-title" data-en="Event Photography" data-es="Fotografía de Eventos">Event Photography</h3>
          <p class="service-description" data-en="Preserve your memories forever. Our professional photographers capture candid moments, emotional exchanges, and joyful celebrations in stunning detail. You'll relive your special day for years to come with beautifully edited, high-resolution images delivered quickly." data-es="Preserve sus recuerdos para siempre. Nuestros fotógrafos profesionales capturan momentos espontáneos, intercambios emocionales y celebraciones alegres con detalles impresionantes. Revivirá su día especial durante años con imágenes de alta resolución bellamente editadas entregadas rápidamente.">
            Preserve your memories forever. Our professional photographers capture candid moments, emotional exchanges, and joyful celebrations in stunning detail. You'll relive your special day for years to come with beautifully edited, high-resolution images delivered quickly.
          </p>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <i class="fas fa-lightbulb"></i>
          </div>
          <h3 class="service-title" data-en="Uplighting & Ambiance" data-es="Iluminación y Ambiente">Uplighting & Ambiance</h3>
          <p class="service-description" data-en="Set the mood and elevate your venue. Custom uplighting and dynamic lighting effects transform any space into an elegant, immersive experience. Whether you want romantic, energetic, or sophisticated—we create the perfect ambiance that complements your vision and impresses every guest." data-es="Establezca el ambiente y eleve su lugar. Los efectos de iluminación personalizados y dinámicos transforman cualquier espacio en una experiencia elegante e inmersiva. Ya sea que desee romántico, energético o sofisticado, creamos la atmósfera perfecta que complementa su visión e impresiona a cada invitado.">
            Set the mood and elevate your venue. Custom uplighting and dynamic lighting effects transform any space into an elegant, immersive experience. Whether you want romantic, energetic, or sophisticated—we create the perfect ambiance that complements your vision and impresses every guest.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Packages Section -->
  <section id="packages" class="packages">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title" data-en="Event Packages" data-es="Paquetes de Eventos">Event Packages</h2>
        <p class="section-subtitle" data-en="Flexible packages designed to fit your budget and vision. Each package includes professional-grade equipment, expert service, and our commitment to making your event exceptional. Mix and match services or go all-in with our premium options." data-es="Paquetes flexibles diseñados para adaptarse a su presupuesto y visión. Cada paquete incluye equipo de grado profesional, servicio experto y nuestro compromiso de hacer que su evento sea excepcional. Mezcle y combine servicios o vaya todo en uno con nuestras opciones premium.">
          Flexible packages designed to fit your budget and vision. Each package includes professional-grade equipment, expert service, and our commitment to making your event exceptional. Mix and match services or go all-in with our premium options.
        </p>
      </div>

      <div class="packages-grid">
        <!-- Package 1: Essential -->
        <div class="package-card">
          <h3 class="package-name" data-en="Essential" data-es="Esencial">Essential</h3>
          <p class="package-price">$800</p>
          <p class="package-tagline" data-en="Great starter option for smaller events" data-es="Excelente opción inicial para eventos más pequeños">Great starter option for smaller events</p>
          <ul class="package-features">
            <li data-en="6 Hours of DJ Service" data-es="6 Horas de Servicio de DJ">
              <i class="fas fa-check"></i> 6 Hours of DJ Service
            </li>
            <li data-en="Sound - Two 12\" Powered speakers" data-es="Sonido - Dos altavoces amplificados de 12\"">
              <i class="fas fa-check"></i> Sound - Two 12" Powered speakers
            </li>
            <li data-en="(2) Moving Head Lights" data-es="(2) Luces de cabeza móvil">
              <i class="fas fa-check"></i> (2) Moving Head Lights
            </li>
            <li data-en="Premium Sound System" data-es="Sistema de Sonido Premium">
              <i class="fas fa-check"></i> Premium Sound System
            </li>
            <li data-en="Basic Lighting Setup" data-es="Configuración Básica de Iluminación">
              <i class="fas fa-check"></i> Basic Lighting Setup
            </li>
            <li data-en="Music Consultation" data-es="Consulta Musical">
              <i class="fas fa-check"></i> Music Consultation
            </li>
            <li data-en="Wireless Microphone" data-es="Micrófono Inalámbrico">
              <i class="fas fa-check"></i> Wireless Microphone
            </li>
          </ul>
          <a href="/quote.html" class="btn btn-outline" data-en="Get Quote" data-es="Obtener Cotización">Get Quote</a>
        </div>

        <!-- Package 2: Signature -->
        <div class="package-card">
          <h3 class="package-name" data-en="Signature" data-es="Signature">Signature</h3>
          <p class="package-price">$1,400</p>
          <p class="package-tagline" data-en="6 hours of service" data-es="6 horas de servicio">6 hours of service</p>
          <ul class="package-features">
            <li data-en="6 Hours of DJ Service" data-es="6 Horas de Servicio de DJ">
              <i class="fas fa-check"></i> 6 Hours of DJ Service
            </li>
            <li data-en="Sound - Two 12\" Powered speakers and one subwoofer" data-es="Sonido - Dos altavoces amplificados de 12\" y un subwoofer">
              <i class="fas fa-check"></i> Sound - Two 12" Powered speakers and one subwoofer
            </li>
            <li data-en="Uplighting (10)" data-es="Iluminación (10)">
              <i class="fas fa-check"></i> Uplighting (10)
            </li>
            <li data-en="(2) Moving Heads Lights" data-es="(2) Luces de cabeza móvil">
              <i class="fas fa-check"></i> (2) Moving Heads Lights
            </li>
            <li data-en="Gobo Name" data-es="Nombre Gobo">
              <i class="fas fa-check"></i> Gobo Name
            </li>
            <li data-en="Premium Sound System" data-es="Sistema de Sonido Premium">
              <i class="fas fa-check"></i> Premium Sound System
            </li>
            <li data-en="Customized Music Planning" data-es="Planificación Musical Personalizada">
              <i class="fas fa-check"></i> Customized Music Planning
            </li>
            <li data-en="Multiple Wireless Mics" data-es="Múltiples Micrófonos Inalámbricos">
              <i class="fas fa-check"></i> Multiple Wireless Mics
            </li>
            <li data-en="Lighting Setup" data-es="Configuración de Iluminación">
              <i class="fas fa-check"></i> Lighting Setup
            </li>
          </ul>
          <a href="/quote.html" class="btn btn-outline" data-en="Get Quote" data-es="Obtener Cotización">Get Quote</a>
        </div>

        <!-- Package 4: Elite (Most Popular) -->
        <div class="package-card package-featured">
          <div class="package-badge" data-en="Most Popular" data-es="Más Popular">Most Popular</div>
          <h3 class="package-name" data-en="Elite ⭐" data-es="Elite ⭐">Elite ⭐</h3>
          <p class="package-price">$1,700</p>
          <p class="package-tagline" data-en="6 hours of service" data-es="6 horas de servicio">6 hours of service</p>
          <ul class="package-features">
            <li data-en="6 Hours of DJ Service" data-es="6 Horas de Servicio de DJ">
              <i class="fas fa-check"></i> 6 Hours of DJ Service
            </li>
            <li data-en="Sound - Two 12\" Powered speakers and two subwoofer" data-es="Sonido - Dos altavoces amplificados de 12\" y dos subwoofers">
              <i class="fas fa-check"></i> Sound - Two 12" Powered speakers and two subwoofer
            </li>
            <li data-en="Uplighting (15)" data-es="Iluminación (15)">
              <i class="fas fa-check"></i> Uplighting (15)
            </li>
            <li data-en="(4) Moving Heads Lights" data-es="(4) Luces de cabeza móvil">
              <i class="fas fa-check"></i> (4) Moving Heads Lights
            </li>
            <li data-en="Gobo Name" data-es="Nombre Gobo">
              <i class="fas fa-check"></i> Gobo Name
            </li>
            <li data-en="Dry Ice (Dance in the clouds effect)" data-es="Hielo seco (Efecto de bailar en las nubes)">
              <i class="fas fa-check"></i> Dry Ice (Dance in the clouds effect)
            </li>
            <li data-en="Premium Sound System" data-es="Sistema de Sonido Premium">
              <i class="fas fa-check"></i> Premium Sound System
            </li>
            <li data-en="Customized Music Planning" data-es="Planificación Musical Personalizada">
              <i class="fas fa-check"></i> Customized Music Planning
            </li>
            <li data-en="Multiple Wireless Mics" data-es="Múltiples Micrófonos Inalámbricos">
              <i class="fas fa-check"></i> Multiple Wireless Mics
            </li>
            <li data-en="Lighting Setup" data-es="Configuración de Iluminación">
              <i class="fas fa-check"></i> Lighting Setup
            </li>
          </ul>
          <a href="/quote.html" class="btn btn-primary" data-en="Get Quote" data-es="Obtener Cotización">Get Quote</a>
        </div>

        <!-- Package 5: Luxe -->
        <div class="package-card">
          <h3 class="package-name" data-en="Luxe" data-es="Luxe">Luxe</h3>
          <p class="package-price">$2,200</p>
          <p class="package-tagline" data-en="6 hours of service" data-es="6 horas de servicio">6 hours of service</p>
          <ul class="package-features">
            <li data-en="6 Hours of DJ Service" data-es="6 Horas de Servicio de DJ">
              <i class="fas fa-check"></i> 6 Hours of DJ Service
            </li>
            <li data-en="Sound - Two 12\" Powered speakers and two subwoofer" data-es="Sonido - Dos altavoces amplificados de 12\" y dos subwoofers">
              <i class="fas fa-check"></i> Sound - Two 12" Powered speakers and two subwoofer
            </li>
            <li data-en="Uplighting (15)" data-es="Iluminación (15)">
              <i class="fas fa-check"></i> Uplighting (15)
            </li>
            <li data-en="(4) Moving Heads Lights" data-es="(4) Luces de cabeza móvil">
              <i class="fas fa-check"></i> (4) Moving Heads Lights
            </li>
            <li data-en="Gobo Name" data-es="Nombre Gobo">
              <i class="fas fa-check"></i> Gobo Name
            </li>
            <li data-en="Dry Ice (Dance in the clouds effect)" data-es="Hielo seco (Efecto de bailar en las nubes)">
              <i class="fas fa-check"></i> Dry Ice (Dance in the clouds effect)
            </li>
            <li data-en="Two Cold Spark Machines" data-es="Dos máquinas de chispas frías">
              <i class="fas fa-check"></i> Two Cold Spark Machines
            </li>
            <li data-en="Two TV's" data-es="Dos televisores">
              <i class="fas fa-check"></i> Two TV's
            </li>
            <li data-en="Premium Sound System" data-es="Sistema de Sonido Premium">
              <i class="fas fa-check"></i> Premium Sound System
            </li>
            <li data-en="Customized Music Planning" data-es="Planificación Musical Personalizada">
              <i class="fas fa-check"></i> Customized Music Planning
            </li>
            <li data-en="Multiple Wireless Mics" data-es="Múltiples Micrófonos Inalámbricos">
              <i class="fas fa-check"></i> Multiple Wireless Mics
            </li>
            <li data-en="Lighting Setup" data-es="Configuración de Iluminación">
              <i class="fas fa-check"></i> Lighting Setup
            </li>
          </ul>
          <a href="/quote.html" class="btn btn-outline" data-en="Get Quote" data-es="Obtener Cotización">Get Quote</a>
        </div>
      </div>

      <!-- Overtime & Add-ons -->
      <div style="margin-top: 60px; text-align: center;">
        <p style="font-size: 18px; color: var(--text-gray); margin-bottom: 20px;" data-en="All packages include 6 hours of service. Additional hours: $200/hour" data-es="Todos los paquetes incluyen 6 horas de servicio. Horas adicionales: $200/hora">
          <strong>All packages include 6 hours of service.</strong> Additional hours: $200/hour
        </p>
        <p style="font-size: 16px; color: var(--text-gray); margin-bottom: 40px; font-style: italic;" data-en="*Pricing does not include Master of Ceremony. MC services can be added to any package." data-es="*El precio no incluye Maestro de Ceremonias. Los servicios de MC se pueden agregar a cualquier paquete.">
          *Pricing does not include Master of Ceremony. MC services can be added to any package.
        </p>

        <h3 style="font-size: 28px; font-weight: 700; margin-bottom: 30px; background: linear-gradient(135deg, #FF1B6D, #00D4FF); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;" data-en="Add-Ons" data-es="Complementos">Add-Ons</h3>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; max-width: 900px; margin: 0 auto;">
          <div style="padding: 20px; background: rgba(255, 27, 109, 0.05); border-radius: 12px; border: 1px solid rgba(255, 27, 109, 0.2);">
            <h4 style="font-size: 18px; font-weight: 600; margin-bottom: 10px;" data-en="Two Cold Spark Machines" data-es="Dos máquinas de chispas frías">Two Cold Spark Machines</h4>
            <p style="font-size: 24px; font-weight: 700; color: #FF1B6D;">$200</p>
          </div>
          
          <div style="padding: 20px; background: rgba(0, 212, 255, 0.05); border-radius: 12px; border: 1px solid rgba(0, 212, 255, 0.2);">
            <h4 style="font-size: 18px; font-weight: 600; margin-bottom: 10px;" data-en="Two TVs" data-es="Dos televisores">Two TVs</h4>
            <p style="font-size: 24px; font-weight: 700; color: #00D4FF;">$200</p>
          </div>
          
          <div style="padding: 20px; background: rgba(255, 27, 109, 0.05); border-radius: 12px; border: 1px solid rgba(255, 27, 109, 0.2);">
            <h4 style="font-size: 18px; font-weight: 600; margin-bottom: 10px;" data-en="Dance in the Clouds" data-es="Bailar en las nubes">Dance in the Clouds</h4>
            <p style="font-size: 24px; font-weight: 700; color: #FF1B6D;">$200</p>
          </div>
          
          <div style="padding: 20px; background: rgba(0, 212, 255, 0.05); border-radius: 12px; border: 1px solid rgba(0, 212, 255, 0.2);">
            <h4 style="font-size: 18px; font-weight: 600; margin-bottom: 10px;" data-en="Gobo Name" data-es="Nombre Gobo">Gobo Name</h4>
            <p style="font-size: 16px; color: var(--text-gray); margin-bottom: 5px;" data-en="Projector & floor stand projection screen" data-es="Proyector y pantalla de proyección con soporte de piso">Projector & floor stand projection screen</p>
            <p style="font-size: 24px; font-weight: 700; color: #00D4FF;">$150</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Wedding Experience Section -->
  <section id="weddings" class="weddings">
    <div class="container">
      <div class="weddings-content">
        <div class="weddings-text">
          <h2 class="weddings-title" data-en="Your Perfect Wedding Day" data-es="Su Día de Boda Perfecto">
            Your Perfect Wedding Day
          </h2>
          <p class="weddings-description" data-en="We understand that your wedding day is one of the most important moments of your life. Our dedicated team works closely with you to create a personalized experience that reflects your unique love story." data-es="Entendemos que el día de su boda es uno de los momentos más importantes de su vida. Nuestro equipo dedicado trabaja estrechamente con usted para crear una experiencia personalizada que refleje su historia de amor única.">
            We understand that your wedding day is one of the most important moments of your life. Our dedicated team works closely with you to create a personalized experience that reflects your unique love story.
          </p>
          
          <div class="weddings-features">
            <div class="wedding-feature">
              <i class="fas fa-heart"></i>
              <div>
                <h4 data-en="Personalized Planning" data-es="Planificación Personalizada">Personalized Planning</h4>
                <p data-en="Custom music selections and timeline coordination" data-es="Selecciones musicales personalizadas y coordinación de cronograma">Custom music selections and timeline coordination</p>
              </div>
            </div>
            
            <div class="wedding-feature">
              <i class="fas fa-rings-wedding"></i>
              <div>
                <h4 data-en="Ceremony to Reception" data-es="Ceremonia a Recepción">Ceremony to Reception</h4>
                <p data-en="Seamless entertainment from start to finish" data-es="Entretenimiento sin interrupciones de principio a fin">Seamless entertainment from start to finish</p>
              </div>
            </div>
            
            <div class="wedding-feature">
              <i class="fas fa-star"></i>
              <div>
                <h4 data-en="Elegant Ambiance" data-es="Ambiente Elegante">Elegant Ambiance</h4>
                <p data-en="Sophisticated lighting that transforms your venue" data-es="Iluminación sofisticada que transforma su lugar">Sophisticated lighting that transforms your venue</p>
              </div>
            </div>
          </div>
          
          <a href="/quote.html" class="btn btn-primary" data-en="Book Your Wedding" data-es="Reserve Su Boda">
            Book Your Wedding
          </a>
        </div>
        
        <div class="weddings-image">
          <img src="/images/first_dance.jpeg" alt="Wedding celebration and first dance" title="Wedding First Dance - Metro Beat Events" loading="lazy">
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery Section -->
  <section id="gallery" class="gallery">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title" data-en="Event Gallery" data-es="Galería de Eventos">Event Gallery</h2>
        <p class="section-subtitle" data-en="See the magic we create at every event" data-es="Vea la magia que creamos en cada evento">
          See the magic we create at every event
        </p>
      </div>
      
      <div class="gallery-grid">
        <div class="gallery-item">
          <img src="/images/dj_od_spinning.jpeg" alt="Professional DJ spinning records at Metro Beat Events DMV" title="DJ Setup - Metro Beat Events" loading="lazy" width="400" height="300">
          <div class="gallery-overlay">
            <i class="fas fa-search-plus"></i>
          </div>
        </div>
        
        <div class="gallery-item">
          <img src="/images/large_event_lighting.jpeg" alt="Professional event uplighting and ambient lighting setup" title="Event Lighting - Metro Beat Events" loading="lazy" width="400" height="300">
          <div class="gallery-overlay">
            <i class="fas fa-search-plus"></i>
          </div>
        </div>
        
        <div class="gallery-item">
